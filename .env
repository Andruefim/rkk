RKK_INTENTION_CORTEX=1
RKK_META_CAUSAL_ENABLED=1
RKK_GOAL_GEN_ENABLED=1
RKK_CURRICULUM_GRAPH_ENABLED=1
RKK_GOAL_TRANSFER_ENABLED=1
RKK_INTENTION_REPLAN_EVERY=120
RKK_INTENTION_STACK_DEPTH=12
RKK_INTENTION_MACRO_TICKS=180
RKK_INTENTION_SUBGOAL_TICKS=400
RKK_INTENTION_L3_HORIZON=48
RKK_INTENTION_NARRATIVE_CAP=32
RKK_GOAL_PROPOSE_EVERY=200
RKK_GOAL_WORLD_SWITCH_EVERY=600

# GPU deliberation (async deep imagination — default-mode thinking)
RKK_DELIBERATION_ENABLED=0
RKK_DELIBERATION_GPU=1
RKK_DELIBERATION_DEVICE=cuda
RKK_DELIBERATION_EVERY=60
