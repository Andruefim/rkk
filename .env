# Live UI: RKK_AGENT_LOOP_HZ>0 → curriculum gate не блокирует subprocess (curriculum_eval_gate).

# Phase 3 (OFF)
RKK_C4_ENABLED=0
RKK_C5_ENABLED=0

# Phase 4 (OFF)
RKK_SPECTRAL_TRANSFER_ENABLED=0
RKK_C6_ENABLED=0
RKK_SKELETON_TRANSFER_ENABLED=0

