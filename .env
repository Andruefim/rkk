# RKK_FE_DECOMP=0
# RKK_EFFERENCE_CORR_PROPRIO=0.9
# RKK_EFFERENCE_CORR_VISION=0.7
# Active Inference: enabled with neural-primary task pipeline (RKK_ACTIVE_INFERENCE near TASK_BINDING)
# Added CPG recovery limits to allow full tuck
RKK_CPG_RECOVERY_HIP_TUCK=0.04
RKK_CPG_RECOVERY_KNEE_FLEX_EXTRA=0.02
RKK_CPG_TORSO_HIP_COEFF=0.05
RKK_CPG_TORSO_KNEE_COEFF=0.03

RKK_INTRINSIC_NAV_PRIORS=1

# --- Generalization roadmap: Phase 0 only (phases 2–6 OFF until gate) ---
