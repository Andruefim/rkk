# Модель, частоты циклов, явные включения фич. Остальное — дефолты в backend (grep RKK_).

# --- ИИ ---
# RKK_OLLAMA_MODEL=gemma4:26b
# Cloud / low-RAM: keep only 0.8b (speech + light generate); embeddings use nomic-embed.
RKK_OLLAMA_MODEL=qwen3.5:0.8b
RKK_TASK_LOG_AI_MODEL=qwen3.5:0.8b
RKK_OLLAMA_THINK=0
# --- Частоты (Гц; 0 = синхронно с тиком / выкл. фон) ---
RKK_AGENT_LOOP_HZ=15
RKK_L3_LOOP_HZ=4
RKK_CPG_LOOP_HZ=60
# 0 = step в intervene под lock (без гонки с agent); 120 давал зависания ~270–280.
RKK_STEPS_PER_DO=12
RKK_CONCEPT_INJECT_EVERY=120
RKK_L4_WORKER=1

# --- Фичи ---
# disable to save memory
RKK_LOCOMOTION_CPG=1
# In-place CPG на ногах пока pelvis закреплён (intent_stride → физика ног).
RKK_CPG_DURING_FIXED_ROOT=1
# intent_torso_forward → прижать бёдра (CPG): RKK_CPG_TORSO_HIP_COEFF, RKK_CPG_TORSO_KNEE_COEFF
RKK_CPG_RECOVERY_HIP_TUCK=0.17
RKK_CPG_RECOVERY_KNEE_FLEX_EXTRA=0.12
RKK_CPG_RECOVERY_WALK_SUPPRESS=0.85

RKK_S2_WM_PLANNER=1
# 0 = WM-кандидат конкурирует с EIG (basal ganglia); 1 = только WM при активной S2-задаче
RKK_S2_WM_GATE_STRICT=0
RKK_GOAL_PLANNING=1

# Wave A: качество дистиллята / готовность снижать LLM_BLEND (diag: distill_* в system2)
RKK_S2_DISTILL_MIN_SUCCESS_RATE=0.25
RKK_S2_DISTILL_RECOVER_MIN_SUCCESS_RATE=0.25
RKK_S2_DISTILL_BLEND_READY_STUDENT_CONF=0.42
RKK_S2_DISTILL_HEALTH_WINDOW=200
# Wave A+: fallback recovery schedule if LLM JSON fails; periodic override distill samples
RKK_S2_RECOVERY_FALLBACK=1
RKK_S2_DISTILL_OVERRIDE_SAMPLE_EVERY=240
# WM при fallen_override (0 = shallow beam, не bundle-only)
RKK_S2_WM_FAST_OVERRIDE=0
RKK_S2_WM_OVERRIDE_SCHEDULE_ONLY=0
RKK_S2_WM_MIN_WM_STEPS=12
RKK_S2_WM_RECOVER_PLAN_DEPTH=4
RKK_S2_WM_CACHE_EVERY=4
RKK_S2_WM_CACHE_EVERY_FALLEN=8
RKK_S2_WM_RECOVER_MAX_BRANCH=32
# S2 Recovery Foundation: CPG ноги во время fallen_override; library; tiered exit
RKK_S2_CPG_DURING_OVERRIDE=1
RKK_S2_RECOVERY_SCRIPTED=1
RKK_S2_RECOVERY_SCRIPTED_RESIDUAL_SCALE=1.65
RKK_S2_RECOVERY_SCRIPTED_STOP_RECOVER_GRAPH=0.64
RKK_S2_RECOVERY_SCRIPTED_TORSO_GRAPH=0.74
RKK_S2_RECOVERY_SCRIPTED_PHYSICS=1
RKK_S2_RECOVERY_SCRIPTED_PHYS_SUBSTEPS=6
RKK_S2_RECOVERY_SCRIPTED_LOCK=1
RKK_S2_RECOVERY_LIBRARY=1
RKK_S2_RECOVERY_LIBRARY_K=8
# RKK_S2_WM_OVERRIDE_SCHEDULE_ONLY=0  # см. блок S2 WM выше
RKK_S2_RECOVER_STOP_RECOVER_GRAPH=0.58
RKK_S2_RECOVER_STOP_RECOVER_GRAPH_MAX=0.72
RKK_S2_RECOVER_STOP_RECOVER_DELTA_MAX=0.22
RKK_S2_RECOVERY_VL_RELAX=1
RKK_S2_RECOVERY_RESIDUAL_SCALE=1.35
# Tiered exit: tier1 progress, tier2 stand (relative com_z)
RKK_S2_OVERRIDE_MIN_POSTURE=0.42
RKK_S2_OVERRIDE_MIN_COM_Z_ABS=0.38
RKK_S2_RECOVER_TIER1_DCOMZ=0.04
RKK_S2_RECOVER_TIER1_DPOSTURE=0.06
RKK_S2_RECOVER_TIER2_DCOMZ=0.08
RKK_S2_OVERRIDE_MIN_FOOT_CONTACT=0.18

# WM train: при активном CPG снижать l_int / lr пока locomotion.reward_ema < порога
RKK_WM_LOCO_GATING=1
RKK_WM_LOCO_REWARD_EMA_MIN=0.45
RKK_WM_LOCO_TRAIN_SCALE_FLOOR=0.25
RKK_WM_LOCO_INT_FLOOR=0.08
RKK_WM_L_INT_LOCO_MULT=0.15
# RKK_CEREBELLUM=1           # forward+inverse модели состояния↔команды ног; после MIN_TRAIN_STEPS заменяет ноги CPG (см. engine/cerebellum.py)
# RKK_REFLEX_STABILIZER=1   # быстрый корректор целей ног в CPG-потоке; обучение в agent-тике (см. engine/reflex_stabilizer.py)
RKK_CAUSAL_MOTOR_EXECUTOR=1   # intent_* × W_masked → суставы (без хардкода программ); см. engine/causal_motor_executor.py
RKK_CAUSAL_BLEND_CPG=0.65     # вес CPG при смешивании с каузальным исполнителем (если нет legacy MLP программ)
RKK_CAUSAL_EXECUTOR_MIN_ALPHA=0.25   # ниже — исполнитель не двигает суставы (только CPG)
RKK_INTERVENTION_BOOTSTRAP_TICKS=500  # сколько первых do(): intent_* кандидатам expected_ig ≥ 0.88
RKK_HOMEOSTATIC_IG=1                  # сигнал обучения System1: |Δ| по posture/com/foot, не d узлов
RKK_IG_FALLEN_POSTURE_TH=0.25        # ниже — считаем упавшим; IG по суставам (cold-start deadlock)
RKK_IG_FALLEN_GAIN=3.0               # усиление PE по суставам когда упал
RKK_IG_DIAG=1                        # [IGDiag] каждые 50 интервенций
# RKK_MOTOR_CORTEX_LEGACY_SPECS=1   # старые walk/balance/reach MLP в motor_cortex (иначе только GNN+CPG)
# RKK_SKILL_LIBRARY=1
RKK_SKILL_LIBRARY_PROB=0.75
# Async scoring races WM/graph on another thread → crashes on Windows; keep 0 locally.

# Tier 1: максимум значимых пар |W|≥thresh из матрицы за тик (без полного graph.edges). Дефолт 2048.
RKK_TIER1_EDGE_CAP=2048
# Snapshot для WS: число рёбер в JSON (не строить 10k+ Edge). Дефолт 512; 0 = только edge_count.
RKK_SNAPSHOT_EDGES_MAX=64
# 0 = не считать EIG в agent.snapshot (было 50 → пики ~25–50 тик)
RKK_SNAPSHOT_ALPHA_EVERY=48
RKK_PUBLIC_STATE_CACHE_MS=600
RKK_VISION_STATE_EVERY=8

RKK_NOTEAR_EVERY=96
# 1 = пересчёт score_interventions каждый engine-тик; N>1 = реже (кеш на N тиков).
# Post-sleep SI ≈ 1100ms/tick; caching every 4 ticks cuts amortized cost to ~275ms.
# Windows: дефолт 12 если не задано; stale-кеш до 8× интервала (RKK_SCORE_STALE_*).
RKK_SCORE_CACHE_EVERY=60
RKK_SCORE_SYNC_CAP_MS=400
# Full PyBullet scene refresh is expensive; manipulation reads its target pose directly.
RKK_SCENE_CACHE_EVERY=6
# Skeleton/ankleQuats/cubes patch every agent tick (1); static_geometry stays on SCENE_CACHE_EVERY.
RKK_SKELETON_EVERY=1
# WS: omit scene.static_geometry except on connect and every N frames (frontend keeps last).
RKK_WS_STATIC_EVERY=30
RKK_SCORE_STALE_MULT=8
RKK_SCORE_STALE_ONLY=1

# Лимит кандидатов после edge-first (Tier1+2+3); сортировка по uncertainty. 0 = без капа. Дефолт 512.
RKK_SCORE_MAX_CANDIDATES=128
# Если discovery застрял — шум к expected_ig (перемешивание ранжирования).
RKK_SCORE_STUCK_DR_MAX=0.02
RKK_SCORE_STUCK_MIN_INTERVENTIONS=800
RKK_SCORE_STUCK_NOISE=0.3
# Случайных frontier-пар (Tier 3) в edge-first score_interventions; 0 = только рёбра + motor×objectives.
RKK_FRONTIER_SAMPLE=64

RKK_VISION_ASYNC_ENCODE=1
# Реже полный encode+cortex после intervene — меньше пиков inner_ms на секунды (hybrid/visual).
RKK_VISION_ENCODE_EVERY=16
# UI poll throttles (backend serves cache — см. mixin_api.get_camera_frame / get_vision_state)
RKK_CAMERA_MIN_INTERVAL_SEC=1.0
RKK_VISION_UI_MIN_INTERVAL_SEC=1.25
RKK_PHASE_M_EVERY=12
RKK_CONCEPT_REFRESH_EVERY=12
# REM replay: не более ~80ms тяжёлой работы за engine-тик (избегаем 10–20s spike на tick 0 сна)
RKK_SLEEP_REM_BUDGET_MS=80
# После REM: grounded consolidate и gc.collect() дают multi-second stall — по умолчанию выкл.

# RKK_MEMORY_RESUME_ON_START=1

# Phase K: Sleep consolidation + autosave.meta.json (рядом с RKK_MEMORY_PATH)
RKK_SLEEP_ENABLED=1
# Не засыпать на ~500 тике (compression_stagnant + MoCap inverse вешали UI).
RKK_SLEEP_MIN_TICKS=2500
RKK_SLEEP_COMPRESSION_COOLDOWN=2500
RKK_SLEEP_EVERY_TICKS=2000
RKK_SLEEP_FALL_THRESHOLD=50
RKK_SLEEP_DURATION_TICKS=100
# 10x LR during REM over-densified W, causing 60x score_interventions slowdown.
# 3x is enough for consolidation without saturating weight matrix.
RKK_SLEEP_REM_LR_MULT=3.0
# После пробуждения: окно тиков с увеличенным минимумом RKK_SCORE_CACHE_EVERY (agent.py).
RKK_POST_SLEEP_SCORE_RELAX_TICKS=720
RKK_POST_SLEEP_SCORE_CACHE_EVERY_FLOOR=40
# fixed_root: сдвиг top-1 кандидата если совпадает с последним do (agent.py).
RKK_FIXED_ROOT_SCORE_ROTATE_TICKS=20
# Aggressive pruning to keep graph sparse after sleep replay.
RKK_SLEEP_PRUNE_THRESHOLD=0.12
# REM: MoCap-клипы в PyBullet + inverse по intent_* (дорого). 0 = только replay падений + WM train в REM.

# --- Humanoid motor smoothness / authority ---
# Чуть выше базовая сила + recovery (ниже) помогают встать после падения / упор руками.
RKK_HUMANOID_MOTOR_TORQUE_SCALE=1.22
RKK_HUMANOID_JOINT_SMOOTH_ALPHA=0.28
RKK_HUMANOID_JOINT_MAX_STEP=0.10
RKK_HUMANOID_CTRL_VEL_MIN=0.40
RKK_HUMANOID_CTRL_VEL_MAX=1.00
RKK_HUMANOID_CTRL_FORCE_MIN=0.58
RKK_HUMANOID_CTRL_FORCE_MAX=1.00
# Масса ног: URDF — масштаб *hip/*knee/*ankle; кастом — множитель звеньев 7–12 (бедро–стопа).
RKK_HUMANOID_URDF_LEG_MASS_SCALE=1.30
RKK_HUMANOID_CUSTOM_LEG_MASS_SCALE=1.12
# Recovery: низкий com_z и/или стопы «в воздухе» → сильнее PD и сильнее intent→spine/плечи (pybullet_humanoid + environment).
RKK_RECOVERY_MOTOR_ENABLE=1
RKK_RECOVERY_MOTOR_BOOST=1.45
RKK_RECOVERY_INTENT_MAP_ENABLE=1
RKK_RECOVERY_COM_Z_BELOW=0.56
RKK_RECOVERY_FOOT_Z_BELOW=0.12
RKK_RECOVERY_SPINE_GAIN_MAX=1.55
RKK_RECOVERY_ARM_GAIN_MAX=1.38
# Постуральный nudge к spine_pitch в recovery (environment._balance_spine_pitch_nudge).
RKK_RECOVERY_BALANCE_REFLEX_MULT=1.32
# Мяч песочницы под тазом на низком CoM: сдвинуть в сторону (pybullet_humanoid._maybe_unstick_ball_from_torso).
RKK_BALL_UNSTUCK_ENABLE=1
RKK_BALL_UNSTUCK_COM_Z_BELOW=0.62
RKK_BALL_UNSTUCK_HORIZ_PAD=0.42
RKK_BALL_UNSTUCK_PUSH=0.62

# --- System 2: медленные макросы (цели + приоритетный intent), student/heuristics ---
# Включение: RKK_SYSTEM2=1 (см. student.py, learned_student.py).
# AGI roadmap Phase 3: priors = genome/priors.py + offline compressor, не LLM; Ollama-priors только bootstrap ниже.
# Планирование: держите RKK_SYSTEM2_PLAN_EVERY кратным/≥ кэшу score (RKK_SCORE_CACHE_EVERY) где возможно.
# При сильном recovery motor — чуть ниже RKK_SYSTEM2_RESIDUAL_SCALE.
RKK_SYSTEM2=1
RKK_SYSTEM2_PLAN_EVERY=52
RKK_SYSTEM2_MACRO_TICKS=40
RKK_SYSTEM2_RESIDUAL_SCALE=0.82
RKK_SYSTEM2_RESIDUAL_MIN_EVERY=8
RKK_SYSTEM2_RESIDUAL_SAME_COOLDOWN=14
RKK_SYSTEM2_RESIDUAL_REDUNDANT=1
RKK_SYSTEM2_MAX_INTENT_DELTA=0.85
RKK_SYSTEM2_FIXED_ROOT=1
RKK_SYSTEM2_DISTILL=1
RKK_SYSTEM2_DISTILL_LOG=logs/system2_distill.jsonl
RKK_SYSTEM2_STUDENT=1
RKK_SYSTEM2_STUDENT_CONF=0.38
RKK_SYSTEM2_STUDENT_LR=0.06
RKK_SYSTEM2_STUDENT_BOOTSTRAP=0
RKK_SYSTEM2_NEURO=1
RKK_SYSTEM2_NEURO_STREAK=10
RKK_SYSTEM2_NEURO_COOLDOWN=2400
RKK_SYSTEM2_NEURO_MAX=2
RKK_S2_FALLEN_CAMERA=exo_only

# --- GNN / WM ---
RKK_WM_PASSIVE_MIX=0.5
# Регуляризация и отображение рёбер: |W_ij|≥RKK_EDGE_THRESH считается ребром (UI, score, edge_count).
# Bootstrap: мягче L1 и ниже порог рёбер, пока граф разгоняется (см. также RKK_INTERVENTION_BOOTSTRAP_TICKS).
RKK_LAMBDA_L1=0.003
RKK_EDGE_THRESH=0.05
# Префиксы узлов: целые строки/столбцы W не обрезаются по порогу сна. Не задано = concept_,proprio_,mc_,intent_.
# Для агрессивной обрезки при раздутом графе: RKK_PRUNE_PROTECT_PREFIXES= (пустое значение — только frozen рёбра).
# RKK_PRUNE_PROTECT_PREFIXES=concept_,proprio_,mc_,intent_

# --- LeWM: Parallel Sequence Training + SIGReg Anti-Collapse ---
# Длиннее последовательности в WM train ≈ hippocampal replay chunks
RKK_WM_SEQ_LEN=8
RKK_WM_SEQ_BATCH=1
RKK_WM_INT_SAMPLES=2
RKK_WM_SIGREG_LAMBDA=0.1
RKK_WM_SIGREG_PROJ=256


# --- Planning / imagination (PFC prospective + cerebellar forward model) ---
RKK_IMAGINATION_STEPS=12
RKK_IMAGINATION_STEPS_FALLEN=6
RKK_IMAGINATION_STEPS_FIXED=4
RKK_VL_IMAGINATION_FALLEN=4
RKK_PLAN_DEPTH=5
RKK_PLAN_DEPTH_MAX=12
RKK_PLAN_BEAM=8
RKK_PLAN_MAX_BRANCH=96
RKK_PLAN_BRANCH_PER_BEAM=24
RKK_PLAN_ACTION_DISCOUNT=0.38
RKK_VL_FALLBACK_TRIES=3
RKK_VL_FALLBACK_TRIES_FALLEN=2
RKK_VL_FAST_FIXED_ROOT=0
RKK_VL_FAST_INTENT=0
RKK_VL_FAST_FALLEN=0
RKK_GOAL_PLAN_MIN_WM_STEPS=16
RKK_PLAN_MAX_BRANCH_FIXED=24
RKK_SYSTEM2_MACRO_TICKS=60

# --- Value Layer (ранняя ходьба) ---
RKK_LOCO_VL_WARMUP_TICKS=0
RKK_LOCO_VL_WARMUP_BLEND=0

# --- Genome walk (innate bipedal CPG priors) ---
# Intents → CPG; direct joint physics off by default (set 1 only if tuning).
RKK_GENOME_WALK=1
RKK_GENOME_WALK_INNATE=1
RKK_GENOME_WALK_FIXED_ROOT=1
# Legs via CPG + intents only (direct joint physics fought CPG and caused falls).
RKK_GENOME_WALK_WARMUP_TICKS=48
RKK_GENOME_WALK_CYCLE_TICKS=48
RKK_GENOME_WALK_GAIN=0.20
RKK_GENOME_WALK_CPG_BOOST=1.42
RKK_CPG_SWING_HIP_LIFT=0.12
RKK_CPG_SWING_KNEE_FLEX=0.13
RKK_GENOME_WALK_JOINT_AMP=2.2
RKK_GENOME_WALK_BIAS_S2=1
RKK_CPG_SWING_HIP_LIFT=0.10
RKK_CPG_SWING_KNEE_FLEX=0.12

# --- Humanoid curriculum ---
# Фаза 1: торс закреплён — без падения, GNN учит intent→joint; затем снятие pelvis.
RKK_AUTO_FIXED_ROOT_TICKS=600
# Release: mastery + posture streak + support_bias swing (не только mq).
RKK_FIXED_ROOT_RELEASE_MASTERY=0.72
RKK_FIXED_ROOT_RELEASE_MIN_TICKS=400
RKK_FR_RELEASE_POSTURE_MIN=0.85
RKK_FR_RELEASE_POSTURE_STREAK=40
RKK_FR_RELEASE_BIAS_RANGE=0.15
RKK_FR_RELEASE_BIAS_WINDOW=30
RKK_POST_FR_STABILIZE_TICKS=120
# После снятия pelvis: сколько тиков подряд в fallen ждать до curriculum fixed_root + reset_stance (0 = сразу, как раньше).
RKK_FR_REATTACH_MIN_FALLEN_TICKS=600
# Жёсткий сброс позы (mixin_fall), если recovery не прогрессирует
RKK_FALL_RECOVERY_TICKS=200
RKK_FALL_RECOVERY_STALL_TICKS=90
# System2 fallen override: лимит тиков до reset_stance при «зависшем» recovery
RKK_S2_OVERRIDE_MAX_TICKS=720
# Let mixin_fall hard-reset the stance; S2 override was keeping robot on floor too long
RKK_S2_DEFER_FALL_HARD_RESET=0
# Pelvis pin max_force linear ramp (ticks) before removing constraint; 0 = instant OFF.
RKK_FR_SOFT_RELEASE_TICKS=40
RKK_POST_FR_REATTACH_TICKS=150
RKK_POST_FR_REATTACH_MAX=3
# Track A Phase 0: post-FR EIG recalibration + WM boost window
RKK_POST_FR_ALPHA_DECAY=0.40
RKK_POST_FR_WM_LR_MULT=2.50
RKK_POST_FR_WM_LR_TICKS=450
RKK_POST_FR_ENSEMBLE_ENT_BOOST=0.25
# Track A Phase 0: eval / curriculum gate
RKK_EVAL_MODE=0
RKK_ADVANCE_EVAL_TICKS=100
RKK_ADVANCE_EVAL_FALLEN_MAX=0.35
RKK_ADVANCE_EVAL_QUALITY_MIN=0.30
RKK_CURRICULUM_EVAL_GATE=1
RKK_EVAL_GATE_SNAPSHOT=state/eval_gate_snapshot.rkk
RKK_EVAL_GATE_RESULT=logs/eval_gate_result.json
RKK_TRANSFER_EVAL_LOG=logs/transfer_eval.jsonl
RKK_FR_REATTACH_POSTURE_MIN=0.82
# Падение: is_fallen True только после N подряд тиков с com_z ниже FALLEN_Z (снимает ложные срабатывания при jerk снятия pin). 1 = как раньше за один тик.
RKK_FALLEN_CONFIRM_TICKS=4
# При fixed_root, пока |compression_gain| низкий: каждый тик подтягивать intent_* к MOTOR_INTENT_DEFAULTS (анти-дрейф без сигнала CG).
RKK_FR_BLIND_MOTOR_DAMP=1
RKK_FR_BLIND_CG_ABS_MAX=0.04
RKK_FR_BLIND_INTENT_EXCURSION_SCALE=0.92
# RKK_FR_BLIND_DAMP_SKIP=intent_wave,intent_look_at
RKK_PHYS_CURRICULUM_INJECT_EVERY=50
# Сколько первых тиков повторять enable_fixed_root, если обёртка env раньше мешала (humanoid под Visual).
# RKK_CURRICULUM_FIXED_ROOT_RETRY_MAX=16
RKK_CURRICULUM_WALK_MIN_TICK=120

RKK_PHASE3_HTTP_TIMEOUT=500

RKK_MOTOR_CORTEX=1
RKK_CPG_ANNEAL_THRESHOLD=0.58   # качество EMA для старта annealing
RKK_CPG_ANNEAL_RATE=5e-5        # скорость fade-out CPG
RKK_CPG_MIN_WEIGHT=0.08         # минимум CPG (остаётся scaffold)
RKK_MC_RSI_MIN_TICKS=1500       # тиков до первого spawn программы

# Level 1-B: Visual Body Grounding
# Opt-in: full visual cortex is expensive; task manipulation uses cached scene registry.
RKK_VISUAL_GROUNDING=0
RKK_GROUNDING_EVERY=120
RKK_GROUNDING_DIST_THRESH=0.22
RKK_GROUNDING_MIN_SCORE=0.25
RKK_GROUNDING_EDGE_W=0.35
RKK_GROUNDING_CONFIRM_N=8

# Level 1-C: Slot Reconstruction Decoder


# Level 2-D: Episodic Fall Memory
RKK_EPISODE_MEMORY=1
RKK_EPISODE_FALL_MAXLEN=50
RKK_EPISODE_SUCCESS_MAXLEN=30
RKK_EPISODE_PRETRIGGER=8
RKK_EPISODE_PATTERN_MIN=3

# Level 2-E: LLM Curriculum Generator

RKK_RSSM_TRAIN_EVERY=16

# AGI Phase 1: Modular Causal WM
RKK_MECHANISM_HIDDEN=24
RKK_DO_DESCENDANT_ONLY=1

# AGI Phase 2: Bayesian structure ensemble (roadmap C2/C3 OFF until Phase 0+1 gate)
RKK_GRAPH_ENSEMBLE_N=4
RKK_GRAPH_ENSEMBLE_MAP=1
RKK_WORLD_BRIDGE_ENABLED=0
RKK_BRIDGE_LOSS_WEIGHT=0.0
