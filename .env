# Pytest выключен по умолчанию (backend/tests/conftest.py); включить: RKK_RUN_TESTS=1


RKK_GROUNDED_LANG=1
RKK_OLLAMA_EMBED_MODEL=nomic-embed-text:latest
RKK_OLLAMA_SPEECH_MODEL=qwen3.5:0.8b
RKK_OLLAMA_URL=http://localhost:11434/api/generate

# Human chat → WM imagination goal → PE verify (opt-in; set 1 for AGI command loop)
RKK_TASK_BINDING=1
RKK_TASK_TREE=1
# Vision-first resolve (camera + depth). Use oracle for legacy registry ablation/tests.
RKK_TASK_RESOLVE=vision
# Non-production sim crutch: when vision is uncertain (no peaked slot), bind from
# privileged oracle XY so approach/FSM can be tested after honest ontology kill (3B).
# Logged as diagnostics.source=sim_oracle_bind / non_production=true. Set 0 for real vision-only.
RKK_SIM_ORACLE_BIND=0
# Phase 2–3 neural-primary approach: latent re-ID + WM/Active Inference nav
RKK_TASK_NAV_MODE=wm_ai
RKK_TASK_NAV_WM_MIN_STEPS=0
RKK_LATENT_REID_MIN_COS=0.55
# When SlotAttention UV is diffuse, bind via depth objectness peak if ontology matched
RKK_VISION_OBJECTNESS_BIND=1
RKK_VISION_OBJECTNESS_BIND_MIN_PEAK=0.18
# Reject objectness peaks within this margin of left/right frame edge
RKK_OBJECTNESS_EDGE_U=0.08
# Hard-lock: force trust live camera when lock stuck at FOV edge vs centered live
RKK_HARD_LOCK_FORCE_LIVE_GAIN=0.45
RKK_HARD_LOCK_EXTREME_B=0.55
RKK_HARD_LOCK_LIVE_CENTER=0.35
RKK_HARD_LOCK_FORCE_DELTA=0.45
# Sustained live↔lock disagreement → repeat force-live / soft-unlock snap
RKK_HARD_LOCK_DIVERGE_B=0.40
RKK_HARD_LOCK_DIVERGE_TICKS=3
RKK_HARD_LOCK_SOFT_UNLOCK_TICKS=6
# When |bearing|<align and range>stop, floor stride over weak AI intents
RKK_NAV_ALIGN_BEARING=0.40
RKK_NAV_FWD_RANGE_MARGIN=0.12
RKK_NAV_ALIGNED_STRIDE_FLOOR=0.62
RKK_NAV_ALIGNED_FWD_BLEND=0.65
RKK_ACTIVE_INFERENCE=1
# Throttle autonomous AI (task wm_ai also caches via RKK_TASK_NAV_AI_EVERY)
RKK_ACTIVE_INFERENCE_EVERY=8
RKK_ACTIVE_INF_ITERS=6
# Task nav: return full optimized intent vector (not only deltas >1e-4)
RKK_ACTIVE_INF_RETURN_ALL=1
RKK_PRECISION_GROUPS=1
# Cache HomeostaticController nav optimize across ticks (keeps neural path)
RKK_TASK_NAV_AI_EVERY=2
# Live camera OWM hard-lock refresh cadence
RKK_OWM_LIVE_REFRESH_EVERY=3
# Soft-unlock + objectness rebind if vision range recedes under hard-lock
RKK_VISION_RECEDE_STREAK=3
RKK_VISION_RECEDE_COOLDOWN=15
# Active look-around retries before escalate (only used when sim-oracle bind is off or fails)
RKK_VISION_ACTIVE_PERCEPT=1
RKK_VISION_ACTIVE_PERCEPT_TRIES=3
RKK_AUTO_VISUAL=1
RKK_SLOT_LABEL_ENABLED=1
# Ontology stage decompose (no heavy LLM at bind)
RKK_TASK_TREE_LLM=0
# Detailed task logs → backend/logs/task_log.jsonl; AI summary every N ticks → ai_task_analysis.txt
# Session logs are wiped on each backend start.
RKK_TASK_LOG=1
RKK_TASK_LOG_AI=0
RKK_TASK_LOG_AI_EVERY=300
RKK_TASK_LOG_PROGRESS_EVERY=25
# Neural / latent / WM / Active Inference diagnostics (why, not only what)
RKK_NEURAL_LOG=1
RKK_NEURAL_LOG_EVERY=15
RKK_NEURAL_LOG_CHANNELS=vision,owm,wm,nav
# Optional: dump truncated latent vectors (default = stats only)
# RKK_NEURAL_LOG_LATENT_FULL=0
# Optional: lighter model for analysis (default = RKK_OLLAMA_MODEL)
# RKK_TASK_LOG_AI_MODEL=qwen3.5:0.8b
# Manipulation: dynamic chair in scene (eval/metrics + oracle ablation; control uses vision)
RKK_MANIP_CHAIR=1
# Manipulation cadence (ticks unless noted)
RKK_MANIP_APPROACH_M=0.9
RKK_MANIP_REACH_MIN_TICKS=16
RKK_MANIP_PUSH_EVERY=4
RKK_MANIP_MIN_DISP=0.12
RKK_MANIP_PUSH_FORCE=38
# Task outcome intero affect (event-only on completion)
RKK_TASK_AFFECT_ENERGY=0.05
RKK_TASK_AFFECT_STRESS=0.18
RKK_TASK_IMAGINE_STEPS=16
RKK_TASK_MIN_TICKS=60
RKK_TASK_DEADLINE_TICKS=2400
# Task motor safety: human_task drives upper body only (balance-critical intents stay with reflex/gait)
RKK_TASK_MOTOR_BODYSPLIT=1
# Ticks after fall-reset during which human_task motor is not registered (lets CPG/reflex re-stabilize)
RKK_TASK_MOTOR_HOLD_TICKS=60