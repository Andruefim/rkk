# AGI Phase 4: Hierarchical Active Inference ELBO
RKK_HAI_ELBO_STEPS=2
RKK_MACRO_PE_SPIKE=0.08

# AGI Phase 5/7: Intrinsic EIG curiosity
# 1 = ensemble EIG bonus in intrinsic step (uses core.forward_dynamics in hypothesis_testing)
RKK_INTRINSIC_EIG=1
RKK_INTRINSIC_EIG_LAMBDA=0.5
RKK_INTRINSIC_MI_SAMPLES=8

# Level 3-G: Proprioception Stream
RKK_PROPRIO_ENABLED=1
RKK_PROPRIO_EVERY=3
RKK_PROPRIO_HIDDEN=24
